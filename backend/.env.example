# LLM Provider Configuration
# Options: openai, xai_grok, lmstudio
LLM_PROVIDER=lmstudio
LLM_MODEL=qwen/qwen3-coder-30b # Model loaded in LMStudio

# API Keys (required based on LLM_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here

# LMStudio Configuration (for local inference)
# LMSTUDIO_API_KEY=not-needed  # Optional, defaults to "not-needed"
# LMSTUDIO_BASE_URL=http://localhost:1234/v1  # Optional, defaults to this URL

# Database Configuration
# You can configure the database connection in TWO ways:

# OPTION 1: Full connection string (simple, one-line)
DATABASE_URL=postgresql://blacklight:blacklight_dev@localhost:5433/blacklight

# OPTION 2: Individual components (easier for beginners, more flexible)
# Uncomment these and comment out DATABASE_URL to use component-based config:
# DB_HOST=localhost
# DB_PORT=5433  # Optional, defaults to 5432
# DB_USER=blacklight
# DB_PASSWORD=blacklight_dev
# DB_NAME=blacklight

# Database Connection Pool Settings (optional, defaults shown)
# DATABASE_POOL_SIZE=10  # Number of connections to keep in pool
# DATABASE_MAX_OVERFLOW=20  # Max additional connections beyond pool_size
# DATABASE_POOL_PRE_PING=true  # Test connections before using them
# DATABASE_ECHO=false  # Set to true to log all SQL queries (development only)

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production-min-32-chars
JWT_LIFETIME_SECONDS=1800 # 30 minutes
ENVIRONMENT=development   # or "production" for HTTPS-only cookies

# Logging Configuration
LOG_LEVEL=INFO # Global log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL_AUTH=DEBUG  # Optional: Override log level for auth feature
# LOG_LEVEL_AGENTS=INFO  # Optional: Override log level for agents feature
# LOG_LEVEL_EXECUTIONS=INFO  # Optional: Override log level for executions feature
LOG_FORMAT=console                # "console" (colored, human-readable) or "json" (for production)
LOG_FILE_ENABLED=true             # Enable file logging
LOG_FILE_PATH=logs/blacklight.log # Path to log file
LOG_ROTATION=daily                # "daily" (rotate at midnight) or "size" (rotate by size)
LOG_RETENTION_DAYS=30             # Days to keep old log files
LOG_MAX_SIZE_MB=100               # Max size in MB before rotation (only for size-based rotation)

# Agent Build System Configuration
AGENT_SANDBOX_ROOT=./backend/generated

# Self-Repair Loop Configuration
MAX_BUILD_RETRIES=3 # Maximum retry attempts for failed builds (with automatic spec revision)

# OAuth2 Social Login Configuration
OAUTH2_ENABLED=false               # Master toggle for OAuth2 feature
FRONTEND_URL=http://localhost:5173 # Frontend URL for OAuth callbacks

# Google OAuth2
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth2
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT=common # or specific tenant ID for single-tenant apps

# GitHub OAuth2
GITHUB_OAUTH_ENABLED=true
GITHUB_CLIENT_ID=Ov23ligGhhuOfpoo5Z2z
GITHUB_CLIENT_SECRET=05c7c2806f81671ffeca95312d55ab4c52aabfc9

# Generic OIDC Provider (e.g., Okta, Auth0, Keycloak)
OIDC_ENABLED=false
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_WELL_KNOWN_URL=https://your-provider.com/.well-known/openid-configuration
OIDC_PROVIDER_NAME=CustomOIDC # Display name for UI
